# Copy to .env, or run `npm run setup:auth` to generate the auth values.
AUTH_USERNAME=
# scrypt hash of the password (never the password itself); generated by `npm run setup:auth`
AUTH_PASSWORD_HASH=
# Random 32+ char secret used to sign session cookies
SESSION_SECRET=
# Free API token from https://metron.cloud (Account > API token)
METRON_API_TOKEN=

# Where store.json lives (defaults to ./data)
# DATA_DIR=./data

# Server (node build)
PORT=3000
# HOST=0.0.0.0

# Behind a reverse proxy/tunnel: lets login throttling see the real client address
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
